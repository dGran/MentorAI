{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.agent-flow/scripts/check-agents-links.sh\" ]; then \"$HOME/.agent-flow/scripts/check-agents-links.sh\" \"$CLAUDE_PROJECT_DIR\"; else echo 'agent-flow no está instalado (falta ~/.agent-flow): reparación de symlinks desactivada. Clona agent-flow y ejecuta su install.sh.'; fi"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.agent-flow/scripts/subagent-context.sh\" ] && \"$HOME/.agent-flow/scripts/subagent-context.sh\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.agent-flow/scripts/readonly-agent-guard.sh\" ] && \"$HOME/.agent-flow/scripts/readonly-agent-guard.sh\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.agent-flow/scripts/edit-check.sh\" ] && \"$HOME/.agent-flow/scripts/edit-check.sh\" || true",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.agent-flow/scripts/stop-gate.sh\" ] && \"$HOME/.agent-flow/scripts/stop-gate.sh\" || true",
            "timeout": 240
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.agent-flow/scripts/iteration-signal.sh\" ] && \"$HOME/.agent-flow/scripts/iteration-signal.sh\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-flow@skills-dir": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)"
    ]
  }
}
